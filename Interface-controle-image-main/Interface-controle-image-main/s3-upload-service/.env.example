# Port d'écoute interne du service. Jamais exposé directement : nginx le proxy
# en interne (voir nginx.conf, location /s3-upload/). Ne pas changer sauf conflit local.
# Volontairement PAS nommé "PORT" : les PaaS (Coolify inclus) injectent souvent une
# variable PORT automatique calquée sur le port exposé du conteneur (80 ici, pour nginx) —
# un service interne qui lirait process.env.PORT hériterait de cette valeur par erreur.
S3_SERVICE_PORT=4000

# Origines autorisées en CORS (séparées par des virgules). "*" = tout le monde.
ALLOWED_ORIGINS=https://votre-site.exemple.com

# ── AWS ──────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── S3 ───────────────────────────────────────────────────────────────────
S3_BUCKET=maisonchazal
# Sous-dossiers logiques dans le bucket (bucket déjà utilisé : ne pas écraser les dossiers existants)
# HD : ne va PAS sur Infologic, seulement sur la BDD Photos (via s3-to-bdd-photos-sync)
# web : va sur Infologic (en direct, hors S3) ET sur la BDD Photos (via S3, comme la HD)
S3_PREFIX_HD=image/products-hd
S3_PREFIX_WEB=image/products-web
# Les objets existants du bucket "maisonchazal" sont publics (ACL public-read) —
# on garde la même convention. Si le PutObject échoue avec une erreur du type
# "AccessControlListNotSupported", les ACLs sont désactivées sur ce bucket :
# vider cette valeur et passer par une bucket policy publique à la place.
S3_ACL=public-read
# URL publique de base si vous utilisez un CDN/CloudFront devant le bucket.
# Sinon laisser vide : l'URL virtual-hosted-style du bucket sera utilisée.
S3_PUBLIC_BASE_URL=
