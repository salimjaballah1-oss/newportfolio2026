AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

S3_BUCKET=maisonchazal
# Doivent correspondre a S3_PREFIX_HD / S3_PREFIX_WEB de s3-upload-service
S3_PREFIX_HD=image/products-hd/
S3_PREFIX_WEB=image/products-web/

# Lecteur reseau de la BDD Photos (PAS le partage GED Infologic -- les HD ne
# doivent pas y aller). Accessible uniquement depuis un poste ou U: est monte.
# Recoit les DEUX variantes (hd et web).
DEST_ROOT=U:\BDD Photos\PHOTOS_V
